      "label": "A-Core: 实时运行课程任务",
      "type": "process",
      "command": "python3",
      "args": ["scripts/acore.py", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }

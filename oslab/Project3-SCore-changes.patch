new file mode 100644
index 0000000..d462945
--- /dev/null
+++ b/test/validation/p3_probe.c
@@ -0,0 +1,102 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <assert.h>
+#include "p3_shared.h"
+static void report(const char *message)
+{
+    sys_move_cursor(0, 10);
+    printf("[P3-CHECK] %s                                      \n", message);
+    sys_reflush();
+}
+static void await(volatile int *flag)
+{
+    long start = sys_get_tick();
+    while (!*flag) {
+        assert(sys_get_tick() - start < 3 * sys_get_timebase());
+        sys_yield();
+    }
+}
+int main(int argc, int worker_id)
+{
+    assert(argc == 1);
+    assert(sys_exec(-1, 0, 0, 0, 0) == -1);
+    assert(sys_exec(worker_id, 4, 0, 0, 0) == -1);
+    assert(sys_waitpid(sys_getpid()) == -1);
+    assert(sys_waitpid(0) == -1);
+    assert(sys_waitpid(1000000) == -1);
+    assert(sys_kill(0) == -1);
+    assert(sys_kill(1000000) == -1);
+    pid_t first = 0;
+    for (int i = 0; i < 40; ++i) {
+        struct p3_shared value = {0};
+        pid_t child = sys_exec(worker_id, 3, P3_RETURN, (uint64_t)&value, P3_MAGIC);
+        assert(child > 0);
+        if (!first) first = child;
+        assert(sys_waitpid(child) == child);
+        assert(value.result == P3_MAGIC);
+    }
+    assert(sys_waitpid(first) == first);
+    report("args/reuse PASS");
+
+    struct p3_shared locks = {0};
+    locks.lock1 = sys_mutex_init(71);
+    locks.lock2 = sys_mutex_init(72);
+    assert(locks.lock1 >= 0 && locks.lock2 >= 0);
+    pid_t holder = sys_exec(worker_id, 3, P3_HOLD, (uint64_t)&locks, 0);
+    assert(holder > 0);
+    await(&locks.holding);
+    pid_t waiter = sys_exec(worker_id, 3, P3_WAIT_LOCKS, (uint64_t)&locks, 0);
+    assert(waiter > 0);
+    await(&locks.waiting);
+    sys_sleep(1);
+    assert(!locks.finished);
+    assert(sys_kill(holder) == holder);
+    assert(sys_waitpid(holder) == holder);
+    assert(sys_waitpid(waiter) == waiter);
+    assert(locks.finished && !locks.unexpected);
+    report("kill-locks PASS");
+
+    pid_t children[20];
+    int count = 0;
+    for (; count < 20; ++count) {
+        children[count] = sys_exec(worker_id, 3, P3_SLEEP, 0, 0);
+        if (children[count] < 0) break;
+    }
+    assert(count > 0 && count < 16);
+    assert(sys_exec(worker_id, 3, P3_SLEEP, 0, 0) == -1);
+    for (int i = 0; i < count; ++i) {
+        assert(sys_kill(children[i]) == children[i]);
+        assert(sys_waitpid(children[i]) == children[i]);
+    }
+    report("capacity PASS");
+
+    struct p3_shared barrier = {0};
+    barrier.barrier = sys_barrier_init(777, 2);
+    assert(barrier.barrier >= 0);
+    assert(sys_barrier_init(777, 2) == barrier.barrier);
+    assert(sys_barrier_init(777, 3) == -1);
+    pid_t blocked = sys_exec(worker_id, 3, P3_BARRIER, (uint64_t)&barrier, 0);
+    assert(blocked > 0);
+    await(&barrier.waiting);
+    sys_sleep(1);
+    assert(!barrier.finished);
+    sys_barrier_destroy(barrier.barrier);
+    assert(sys_waitpid(blocked) == blocked && barrier.finished);
+    barrier.waiting = barrier.finished = 0;
+    barrier.barrier = sys_barrier_init(777, 2);
+    blocked = sys_exec(worker_id, 3, P3_BARRIER, (uint64_t)&barrier, 0);
+    assert(blocked > 0);
+    await(&barrier.waiting);
+    sys_sleep(1);
+    assert(sys_kill(blocked) == blocked);
+    assert(sys_waitpid(blocked) == blocked);
+    sys_barrier_destroy(barrier.barrier);
+    int one = sys_barrier_init(777, 1);
+    assert(one >= 0);
+    sys_barrier_wait(one);
+    sys_barrier_destroy(one);
+    report("barrier-cancel PASS");
+    report("all PASS");
+    return 0;
+}
diff --git a/test/validation/p3_shared.h b/test/validation/p3_shared.h
new file mode 100644
index 0000000..5dce896
--- /dev/null
+++ b/test/validation/p3_shared.h
@@ -0,0 +1,20 @@
+#ifndef P3_SHARED_H
+#define P3_SHARED_H
+#include <stdint.h>
+#define P3_RETURN 1
+#define P3_HOLD 2
+#define P3_WAIT_LOCKS 3
+#define P3_SLEEP 4
+#define P3_BARRIER 5
+#define P3_MAGIC 0x12345678UL
+struct p3_shared {
+    volatile int holding;
+    volatile int waiting;
+    volatile int finished;
+    volatile int unexpected;
+    volatile uint64_t result;
+    int lock1;
+    int lock2;
+    int barrier;
+};
+#endif
diff --git a/test/validation/p3_worker.c b/test/validation/p3_worker.c
new file mode 100644
index 0000000..df114c7
--- /dev/null
+++ b/test/validation/p3_worker.c
@@ -0,0 +1,51 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <assert.h>
+#include "p3_shared.h"
+static long raw_write(const char *s)
+{
+    register long a0 asm("a0") = (long)s;
+    register long a7 asm("a7") = 20;
+    asm volatile("ecall" : "+r"(a0) : "r"(a7) : "memory");
+    return a0;
+}
+int main(int argc, uint64_t mode, uint64_t address, uint64_t value)
+{
+    assert(argc == 3);
+    if (mode == P3_SLEEP) {
+        sys_sleep(30);
+        return 0;
+    }
+    struct p3_shared *shared = (struct p3_shared *)address;
+    assert(shared != 0);
+    if (mode == P3_RETURN) {
+        assert(value == P3_MAGIC);
+        assert(sys_getpid() > 1);
+        sys_move_cursor(0, 12);
+        /* A new PID must retain access to its own image's constant strings. */
+        assert(raw_write("[P3-WORKER] image/args checked") == 0);
+        assert(raw_write((const char *)1) == -14);
+        shared->result = value;
+        return 0;
+    }
+    if (mode == P3_HOLD) {
+        sys_mutex_acquire(shared->lock1);
+        sys_mutex_acquire(shared->lock2);
+        shared->holding = 1;
+        sys_sleep(30);
+        shared->unexpected = 1;
+    } else if (mode == P3_WAIT_LOCKS) {
+        shared->waiting = 1;
+        sys_mutex_acquire(shared->lock1);
+        sys_mutex_acquire(shared->lock2);
+        shared->finished = 1;
+        sys_mutex_release(shared->lock2);
+        sys_mutex_release(shared->lock1);
+    } else if (mode == P3_BARRIER) {
+        shared->waiting = 1;
+        sys_barrier_wait(shared->barrier);
+        shared->finished = 1;
+    } else assert(0);
+    return 0;
+}

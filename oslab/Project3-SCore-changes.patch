+int do_kill(pid_t pid)
+{
+    uint64_t flags = irq_save();
+    pcb_t *task = find_process(pid);
+    if (pid <= 0 || !task || task->status == TASK_EXITED) {
+        irq_restore(flags);
+        return -1;
+    }
+    int self = task == current_running;
+    finish_process(task);
+    if (self) {

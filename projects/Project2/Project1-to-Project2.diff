+
+enum ExcCode
+{
+    EXCC_INST_MISALIGNED  = 0,
+    EXCC_INST_ACCESS      = 1,
+    EXCC_BREAKPOINT       = 3,
+    EXCC_LOAD_ACCESS      = 5,
+    EXCC_STORE_ACCESS     = 7,
+    EXCC_SYSCALL          = 8,
+    EXCC_INST_PAGE_FAULT  = 12,

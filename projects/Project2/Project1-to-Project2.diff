+    report("lock-held");
+    sys_sleep(1); /* keep ownership, ensuring the other probe blocks */
+    report("lock-release");
+    sys_mutex_release(lock);
+    start = sys_get_tick();
+    sys_sleep(1);
+    assert(sys_get_tick() - start >= base);
+    report("PASS");

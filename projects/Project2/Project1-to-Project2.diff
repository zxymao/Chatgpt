+static inline uint64_t irq_save(void)
+{
+    uint64_t old;
+    __asm__ volatile ("csrrc %0, sstatus, %1" : "=r"(old) : "r"(2UL) : "memory");
+    return old;
+}
+static inline void irq_restore(uint64_t old)
+{
+    if (old & 2UL)
+        __asm__ volatile ("csrs sstatus, %0" :: "r"(2UL) : "memory");
+}

+handler_t irq_table[IRQC_COUNT];
+handler_t exc_table[EXCC_COUNT];
+
+void interrupt_helper(regs_context_t *regs, uint64_t stval, uint64_t scause)
+{
+    uint64_t code = scause & ~SCAUSE_IRQ_FLAG;
+    if (scause & SCAUSE_IRQ_FLAG) {
+        if (code < IRQC_COUNT) irq_table[code](regs, stval, scause);
+        else handle_other(regs, stval, scause);
+    } else {
+        if (code < EXCC_COUNT) exc_table[code](regs, stval, scause);
+        else handle_other(regs, stval, scause);
+    }
+}
+
+void handle_irq_timer(regs_context_t *regs, uint64_t stval, uint64_t scause)
+{
+    (void)regs; (void)stval; (void)scause;
+    bios_set_timer(get_ticks() + TIMER_INTERVAL);
+    screen_reflush();
+    do_scheduler();
+}
+
+void init_exception()
+{
+    for (int i = 0; i < EXCC_COUNT; ++i) exc_table[i] = handle_other;
+    for (int i = 0; i < IRQC_COUNT; ++i) irq_table[i] = handle_other;
+#if LAB_STAGE >= 3
+    exc_table[EXCC_SYSCALL] = handle_syscall;
+#endif
+#if LAB_STAGE >= 4
+    irq_table[IRQC_S_TIMER] = handle_irq_timer;
+#endif
+    setup_exception();
+}

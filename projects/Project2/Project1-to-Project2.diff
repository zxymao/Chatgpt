+        begin < current_running->user_stack_base + PAGE_SIZE)
+        limit = current_running->user_stack_base + PAGE_SIZE;
+    if (!limit) return -14;
+    char *text = (char *)p;
+    uint64_t i = 0;
+    while (begin + i < limit && text[i]) ++i;
+    if (begin + i == limit) return -14;
+    screen_write(text);

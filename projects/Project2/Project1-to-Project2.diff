+static void init_pcb_stack(ptr_t ktop, ptr_t utop, ptr_t entry, pcb_t *task)
+{
+    regs_context_t *regs = (regs_context_t *)(ktop - sizeof(*regs));
+    switchto_context_t *sw = (switchto_context_t *)((ptr_t)regs - sizeof(*sw));
+    bzero(regs, sizeof(*regs));
+    bzero(sw, sizeof(*sw));
+    regs->regs[2] = utop;
+    regs->sepc = entry;
+#if LAB_STAGE >= 3
+    /* SPP=0 returns to U mode; SPIE controls SIE after sret. */
+    regs->sstatus = SR_SPIE;
+#else
+    /* Cooperative tasks share S mode and call the jump table directly. */
+    regs->regs[4] = (ptr_t)task;
+    regs->sstatus = SR_SPP;
+#endif
+    sw->regs[0] = (ptr_t)ret_from_exception;
+    sw->regs[1] = (ptr_t)sw;
+    task->kernel_sp = (ptr_t)sw;
+    task->user_sp = utop;
+}
